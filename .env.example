# --- ElevenLabs Agents (ver DEMO/02-agente-demo.md) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# El Bearer que mandan las tools del agente a /api/demo/*
# generalo con: openssl rand -hex 32
AUGLO_DEMO_SECRET=

# Storage. Vercel ya no ofrece KV propio: se crea un Upstash for Redis desde
# Vercel > Storage y la integración inyecta UPSTASH_REDIS_REST_*. Los KV_* se
# siguen aceptando por compatibilidad. Sin ninguno de los dos la app corre igual,
# en memoria, y lo dice en los logs — pero en Vercel eso NO sirve para el stand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Interruptor de pánico: apaga sólo la demo de llamada, sin redeploy.
DEMO_HABILITADA=true
