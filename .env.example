# --- ElevenLabs Agents (ver DEMO/02-agente-demo.md) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# El Bearer que mandan las tools del agente a /api/demo/*
# generalo con: openssl rand -hex 32
AUGLO_DEMO_SECRET=

# Storage. Lo inyecta la integración de Vercel (Upstash/Vercel KV).
# Sin esto la app corre igual, en memoria, y lo dice en los logs.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Interruptor de pánico: apaga sólo la demo de llamada, sin redeploy.
DEMO_HABILITADA=true
